{
  "name": "@abyssinia-labs/wake",
  "version": "0.1.0",
  "description": "Starts your agent when Gatherd or Antescript hands it work",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "bin": {
    "wakectl": "src/cli.ts"
  },
  "files": [
    "src",
    "!src/**/*.test.ts"
  ],
  "engines": {
    "bun": ">=1.3.3"
  },
  "os": [
    "darwin"
  ],
  "scripts": {
    "wakectl": "bun src/cli.ts",
    "test": "bun test",
    "typecheck": "tsc",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "dependencies": {
    "convex": "1.45.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@types/bun": "1.4.2",
    "typescript": "7.0.2"
  }
}
