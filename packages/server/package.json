{
  "name": "@abyssinia-labs/wake-server",
  "version": "0.2.0",
  "description": "The server half of wake/v1 for any TypeScript app: let Wake start your users' agents, on Postgres with Drizzle",
  "keywords": [
    "agents",
    "wake",
    "drizzle",
    "postgres",
    "server-sent-events"
  ],
  "homepage": "https://wakectl.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Abyssinia-Labs/wake.git",
    "directory": "packages/server"
  },
  "bugs": "https://github.com/Abyssinia-Labs/wake/issues",
  "author": "Abyssinia Labs LLC",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/test-*.ts",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./drizzle": {
      "types": "./dist/drizzle/index.d.ts",
      "default": "./dist/drizzle/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "scripts": {
    "build": "rm -rf dist && tsc --project ./tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "peerDependencies": {
    "drizzle-orm": ">=0.45.0 <1"
  },
  "peerDependenciesMeta": {
    "drizzle-orm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "drizzle-orm": "0.45.4"
  }
}
