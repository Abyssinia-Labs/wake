---
// How it works, shown rather than told: one run through Wake for GitHub,
// from an issue labelled `wake` to the pull request, as a stepped demo.
// The island plays itself; the section around it is static.
import { SectionHeader } from "@/components/site/text";
import { WakeDemo } from "./wake-demo";
---

<section class="not-content flex flex-col gap-10 py-20">
  <SectionHeader
    title="An issue labelled wake. Claude Code on your Mac. A pull request."
    lead="One run, start to finish, through Wake for GitHub. Gatherd and Antescript hand work over the same way, and so does any app that serves wake/v1."
  />
  <WakeDemo client:visible />
</section>
