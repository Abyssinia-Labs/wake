---
import SocialIcons from "@astrojs/starlight/components/SocialIcons.astro";
import { Mark } from "@/components/site/mark";
import { ThemeToggle } from "@/components/site/theme-toggle";
import { buttonVariants } from "@/components/ui/button";
import { cn } from "@/lib/utils";
// The site header: brand, the five site links, Starlight's search and theme
// picker, GitHub, and a Get started button. Starlight's own pieces keep
// their scripts; chrome.css dresses them.
import Search from "./Search.astro";

const { siteTitleHref } = Astro.locals.starlightRoute;
const path = Astro.url.pathname;
const links = [
  { label: "Docs", href: "/start/getting-started/", under: ["/start/", "/reference/"] },
  { label: "Guides", href: "/guides/github/", under: ["/guides/"] },
  { label: "For apps", href: "/apps/overview/", under: ["/apps/"] },
  { label: "Spec", href: "/spec/wake-v1/", under: ["/spec/"] },
  // From 60rem only: below it five links and the search button don't fit,
  // and the sidebar, footer and hero all link to it anyway.
  { label: "Changelog", href: "/changelog/", under: ["/changelog/"], wide: true },
];
const isCurrent = (under: string[]): boolean => under.some((prefix) => path.startsWith(prefix));
---

<div class="site-header">
  <a href={siteTitleHref} class="brand">
    <Mark className="size-7" />
    <span>wakectl</span>
  </a>
  <nav aria-label="Site" class="site-nav">
    {
      links.map(({ label, href, under, wide }) => (
        <a
          href={href}
          aria-current={isCurrent(under) ? "page" : undefined}
          data-wide={wide ? "" : undefined}
        >
          {label}
        </a>
      ))
    }
  </nav>
  <div class="search print:hidden">
    <Search />
  </div>
  <div class="right print:hidden">
    <SocialIcons />
    <ThemeToggle client:load />
    <a href="/start/getting-started/" class={cn(buttonVariants({ size: "sm" }), "no-underline")}>Get started</a>
  </div>
</div>
