---
// The landing hero: what's new and the badges, the headline and the tagline,
// then a door for each kind of visitor (hero-doors.tsx): someone who builds
// a product gets what Wake gives their users and the server half's install
// line, someone who writes code gets where they can summon their agent from,
// wakectl's install line and Wake for Mac's download. Beside it, Wake at
// work as the theme that is on draws it: in Burrow, Wake for Mac's window
// with a run printing its steps (live-run.tsx), so what Wake does shows at
// once; in Annunciator and Signal, their art (hero-art.tsx).
import { Code } from "@astrojs/starlight/components";
import { HeroArt } from "@/components/landing/hero-art";
import { HeroDoors } from "@/components/landing/hero-doors";
import { LiveRun } from "@/components/landing/live-run";
import { HeroBadges } from "@/components/site/hero-badges";
import { MacDownload } from "@/components/site/mac-download";
import { latest, wakeLog } from "@/lib/changelog";
import { macBuild } from "@/lib/mac";

// Starlight's PAGE_TITLE_ID: the skip link's target.
const PAGE_TITLE_ID = "_top";

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline } = data.hero ?? {};
const doors = data.heroDoors ?? [];
const install = "bun add -g @abyssinia-labs/wake\nwake setup";
const serve =
  "# on Convex\nbun add @abyssinia-labs/wake-convex\n# on anything else\nbun add @abyssinia-labs/wake-server";
// The newest release on npm, and its lead headline, linking to its notes.
const newest = latest(wakeLog);
if (!newest) throw new Error("CHANGELOG.md has no release to show.");
const news = {
  version: newest.release.version,
  headline: newest.headline,
  href: `/changelog/#${newest.release.anchor}`,
};
---

<div
  class="hero not-content grid gap-x-12 gap-y-6 py-10 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:grid-rows-[auto_1fr] lg:py-16"
>
  <div class="flex flex-col gap-6 lg:col-start-1 lg:row-start-1">
    <HeroBadges news={news} />
    <h1 id={PAGE_TITLE_ID} data-page-title class="wake-headline" set:html={title} />
    {tagline && <p class="m-0 max-w-[36rem] text-lg leading-relaxed text-foreground" set:html={tagline} />}
  </div>
  {/* Wake at work comes right after the headline on a phone, beside it on a wide screen. */}
  <div class="flex min-w-0 flex-col lg:col-start-2 lg:row-span-2 lg:row-start-1">
    <div class="for-theme for-burrow lg:pt-24">
      <LiveRun client:visible />
    </div>
    <div class="mx-auto w-full max-w-[25rem] lg:my-auto lg:mr-0">
      <HeroArt />
    </div>
  </div>
  <div class="hero-doors flex min-w-0 flex-col gap-6 lg:col-start-1 lg:row-start-2">
    <HeroDoors client:load doors={doors} />
    <div data-door="product" class="max-w-[36rem]">
      <Code code={serve} lang="bash" frame="terminal" title="Terminal" />
    </div>
    <div data-door="developer" class="flex max-w-[36rem] flex-col gap-6">
      <Code code={install} lang="bash" frame="terminal" title="Terminal" />
      <MacDownload build={macBuild} />
    </div>
  </div>
</div>
