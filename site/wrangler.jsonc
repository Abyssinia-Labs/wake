// wakectl.dev: the built site as a Worker's static assets, nothing else.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wakectl-site",
  "compatibility_date": "2026-09-25",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "wakectl.dev", "custom_domain": true }]
}
